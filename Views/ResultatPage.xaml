<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge_.Views.ResultatPage"
             Title="ResultatPage">
    <VerticalStackLayout
        Padding="20"
        Spacing="16">
        <Label
            x:Name="lblMessage"
            FontSize="22" 
             />
        <button 
            x:Name="btnRetour"
            Text="Retour"
            Clicked="OnRetourClicked"
            HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>