<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge_.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="12"
            >
            <Label 
                Text="Nom"
                FontSize="16"
                HorizontalOptions="Center" />
            <Entry
                x:Name="entryNom"
                Placeholder="votre nom"
                HorizontalOptions="Fill" />
                <Label 
                Text="Date de Naissance"
                FontSize="16"
                HorizontalOptions="Center" />
            <DatePicker 
                x:Name="PickerDate" />
            <Button 
                x:Name="btnCalculer"
                Text="Calculer"
                Clicked="OnCalculerClicked"
                HorizontalOptions="Center" />
            <Label 
                x:Name="lblResultat"
                FontSize="20"
                IsVisible="False"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
